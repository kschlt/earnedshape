#!/bin/sh
# Checks every commit about to be pushed, plus the tracked files, before
# they become public. Enable with: git config core.hooksPath tools/hooks
root=$(git rev-parse --show-toplevel) || exit 1
deny=${PUBLIC_GUARD_DENY:-$root/.aos/public-deny.txt}
set --
[ -f "$deny" ] && set -- --deny-file "$deny"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # branch deletion
  python3 "$root/tools/public_guard.py" "$root" --commits "$local_sha" "$@" || status=1
done
exit $status
